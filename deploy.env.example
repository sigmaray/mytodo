# Copy to .env.production and set a percent-encoded PostgreSQL connection URL.
# Create the database first with ~/r/sandbox/infra/postgres/scripts/create-database.sh todoist
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@postgresql:5432/todoist

# Local loopback port for maintenance checks; public access is through the shared Caddy proxy.
TODOIST_HTTP_PORT=18082
