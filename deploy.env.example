# Copy to .env.production and set these values for your shared PostgreSQL service.
MYTODO_DB_HOST=postgresql
MYTODO_DB_PORT=5432
MYTODO_DB_USER=postgres
MYTODO_DB_PASSWORD=replace-with-the-database-password
MYTODO_DB_NAME=todoist

# Local loopback port for maintenance checks; public access is through the shared Caddy proxy.
MYTODO_HTTP_PORT=18082
