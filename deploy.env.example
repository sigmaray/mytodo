# Copy to .env.production and set these values for your shared PostgreSQL service.
MYTODO_DB_HOST=postgresql
MYTODO_DB_PORT=5432
MYTODO_DB_USER=postgres
MYTODO_DB_PASSWORD=replace-with-the-database-password
MYTODO_DB_NAME=todoist

# Set true to enable project archiving; defaults to false.
MYTODO_PROJECT_ARCHIVING_ENABLED=false

# Enable comment attachments with true; set false to hide attachment UI and disable attachment API routes.
MYTODO_ATTACHMENTS_ENABLED=true
# Storage path is required when attachments are enabled. The API volume is persistent.
MYTODO_ATTACHMENTS_DIR=/var/lib/mytodo/attachments

# Local loopback port for maintenance checks; public access is through the shared Caddy proxy.
MYTODO_HTTP_PORT=18082
